# AG35 sur hébergement mutualisé : le site est servi depuis public/, le reste du dossier est inaccessible.
Options -Indexes

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Toujours en HTTPS.
    RewriteCond %{HTTPS} !=on
    RewriteCond %{HTTP:X-Forwarded-Proto} !=https
    RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

    # Renouvellement du certificat SSL.
    RewriteRule ^\.well-known/ - [L]

    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>

# Sans mod_rewrite, rien n'est servi plutôt que d'exposer la configuration.
<IfModule !mod_rewrite.c>
    Require all denied
</IfModule>

<FilesMatch "^\.(env|git)|\.(sqlite|log|zip)$">
    Require all denied
</FilesMatch>
